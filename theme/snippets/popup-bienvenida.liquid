<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600&family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<style>
.bm-pop{position:fixed;left:24px;bottom:24px;z-index:2147483000;width:344px;max-width:calc(100vw - 32px);background:#FFF8F4;color:#2B2A3D;border-radius:24px;box-shadow:0 20px 50px rgba(43,42,61,.22),0 2px 6px rgba(43,42,61,.08);font-family:'Nunito',system-ui,sans-serif;overflow:hidden;opacity:0;visibility:hidden;transform:translateY(24px);transition:opacity .35s ease,transform .35s ease,visibility 0s linear .35s}
.bm-pop.is-open{opacity:1;visibility:visible;transform:none;transition:opacity .35s ease,transform .35s ease}
.bm-pop__top{position:relative;background:#F6D3CD;padding:22px 56px 20px 24px}
.bm-pop__top svg.bm-pop__heart{display:block;margin-bottom:8px}
.bm-pop__eyebrow{margin:0;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.bm-pop__title{margin:6px 0 0;font-family:'Fredoka',system-ui,sans-serif;font-weight:600;font-size:30px;line-height:1.05}
.bm-pop__close{position:absolute;top:8px;right:8px;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:transparent;color:#2B2A3D;cursor:pointer;display:flex;align-items:center;justify-content:center}
.bm-pop__close:hover{background:rgba(255,255,255,.55)}
.bm-pop__close:focus-visible,.bm-pop__btn:focus-visible{outline:3px solid #2B2A3D;outline-offset:2px}
.bm-pop__body{padding:18px 24px 22px}
.bm-pop__text{margin:0 0 14px;font-size:15px;line-height:1.5;color:#3D3B52}
.bm-pop__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.bm-pop__input{display:block;width:100%;box-sizing:border-box;height:48px;margin:0;padding:0 18px;border:1.5px solid #D8C6BF;border-radius:999px;background:#FFFFFF;color:#2B2A3D;font:inherit;font-size:15px}
.bm-pop__input::placeholder{color:#6B6880}
.bm-pop__input:focus{outline:none;border-color:#2B2A3D;box-shadow:0 0 0 3px #F6D3CD}
.bm-pop__btn{display:block;width:100%;height:48px;margin:10px 0 0;border:0;border-radius:999px;background:#2B2A3D;color:#FFFFFF;font:inherit;font-size:15px;font-weight:800;cursor:pointer}
.bm-pop__btn:hover{background:#45435C}
.bm-pop__legal{margin:12px 0 0;font-size:12px;line-height:1.45;color:#6B6880}
.bm-pop__legal a{color:#2B2A3D}
.bm-pop__err{margin:8px 0 0;font-size:13px;font-weight:700;color:#B42318}
.bm-pop__code{display:inline-block;margin:0 0 12px;padding:10px 22px;border:2px dashed #2B2A3D;border-radius:12px;background:#FFFFFF;font-family:'Fredoka',system-ui,sans-serif;font-weight:600;font-size:22px;letter-spacing:.12em}
@media (max-width:480px){.bm-pop{left:12px;right:12px;bottom:12px;width:auto;max-width:none}.bm-pop__title{font-size:26px}}
@media (prefers-reduced-motion:reduce){.bm-pop,.bm-pop.is-open{transition:none;transform:none}}
</style>
<div class="bm-pop" id="bm-pop" role="dialog" aria-labelledby="bm-pop-title" aria-hidden="true">
<div class="bm-pop__top">
<svg class="bm-pop__heart" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2B2A3D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
<p class="bm-pop__eyebrow">Bienvenida a la familia</p>
<p class="bm-pop__title" id="bm-pop-title">10 % en tu primer pedido</p>
<button type="button" class="bm-pop__close" aria-label="Cerrar" data-bm-close><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
</div>
<div class="bm-pop__body">
{% form 'customer', id: 'bm-pop-form' %}
{% if form.posted_successfully? %}
<p class="bm-pop__text" data-bm-done><strong>¡Ya eres de la familia!</strong> Este es tu código de regalo:</p>
<div class="bm-pop__code">BIENVENIDA10</div>
<p class="bm-pop__text" style="margin:0">Escríbelo al pagar tu primer pedido.</p>
{% else %}
<p class="bm-pop__text">Suscríbete y recibe novedades, ideas de regalo y ofertas para tu peque.</p>
<input type="hidden" name="contact[tags]" value="newsletter,popup-bienvenida">
<label class="bm-pop__sr" for="bm-pop-email">Tu e-mail</label>
<input class="bm-pop__input" id="bm-pop-email" type="email" name="contact[email]" placeholder="Tu e-mail" autocomplete="email" required>
<button class="bm-pop__btn" type="submit">Quiero mi 10 %</button>
{% if form.errors %}<p class="bm-pop__err" data-bm-err>Revisa tu e-mail e inténtalo de nuevo.</p>{% endif %}
<p class="bm-pop__legal">Al suscribirte aceptas recibir e-mails de Bebé Modas. Puedes darte de baja cuando quieras. <a href="/policies/privacy-policy">Política de privacidad</a></p>
{% endif %}
{% endform %}
</div>
</div>
<script>
(function(){
var p=document.getElementById('bm-pop');if(!p)return;
var KC='bmPopClosed',KS='bmPopSubscribed';
function get(k){try{return localStorage.getItem(k)}catch(e){return null}}
function put(k,v){try{localStorage.setItem(k,v)}catch(e){}}
function open(){p.classList.add('is-open');p.setAttribute('aria-hidden','false')}
function close(){p.classList.remove('is-open');p.setAttribute('aria-hidden','true');put(KC,String(Date.now()))}
p.querySelector('[data-bm-close]').addEventListener('click',close);
p.addEventListener('keydown',function(e){if(e.key==='Escape')close()});
var done=p.querySelector('[data-bm-done]'),err=p.querySelector('[data-bm-err]');
if(done){put(KS,'1');open();return}
if(err){open();return}
if(get(KS))return;
var last=parseInt(get(KC)||'0',10);
if(last&&Date.now()-last<7*864e5)return;
var shown=false;function go(){if(shown)return;shown=true;open();window.removeEventListener('scroll',onS)}function onS(){var d=document.documentElement;if((window.scrollY+window.innerHeight)/d.scrollHeight>0.5)go()}window.addEventListener('scroll',onS,{passive:true});setTimeout(go,20000);
})();
</script>
