{% doc %}
  @prompt
    GLOWING TEXT
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.alignment }};
    font-family: {{ block.settings.font_choice }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.2;
    margin: 0;
    text-shadow: 0 0 {{ block.settings.glow_blur }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_blur | times: 2 }}px {{ block.settings.glow_color }};
  }
{% endstyle %}

<div class="ai-glow-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.text | escape }}
</div>

{% schema %}
{
  "name": "Glowing text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Make it shine"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "font_choice",
      "label": "Font",
      "options": [
        { "value": "inherit", "label": "Theme font" },
        { "value": "sans-serif", "label": "Sans serif" },
        { "value": "serif", "label": "Serif" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1B18"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#FAEAA1"
    },
    {
      "type": "range",
      "id": "glow_blur",
      "label": "Glow intensity",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Glowing text"
    }
  ],
  "tag": null,
  "class": "glowing-text-block"
}
{% endschema %}